{
   "action": {
      "default_icon": {
         "128": "icons/ScrapDog logo.png",
         "16": "icons/ScrapDog logo.png",
         "32": "icons/ScrapDog logo.png",
         "48": "icons/ScrapDog logo.png"
      },
      "default_popup": "popup.html",
      "default_title": "ScrapDog"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "csv_exporter.js", "content_script.js" ],
      "matches": [ "*://*.facebook.com/*", "*://*.fb.com/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Scrapes comments from Facebook and social posts, expands replies and full text, updates progress live, and exports to CSV.",
   "host_permissions": [ "*://*.facebook.com/*", "*://*.fb.com/*" ],
   "icons": {
      "128": "icons/ScrapDog logo.png",
      "16": "icons/ScrapDog logo.png",
      "32": "icons/ScrapDog logo.png",
      "48": "icons/ScrapDog logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "ScrapDog",
   "permissions": [ "tabs", "activeTab", "scripting", "storage", "unlimitedStorage", "downloads" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.2",
   "web_accessible_resources": [ {
      "matches": [ "*://*.facebook.com/*", "*://*.fb.com/*" ],
      "resources": [ "csv_exporter.js", "icons/*.png" ]
   } ]
}
